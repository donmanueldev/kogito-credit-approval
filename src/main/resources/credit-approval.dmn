      <semantic:requiredInput href="#i_monthlyDebt" />
    </semantic:informationRequirement>
    <semantic:literalExpression id="_8F257952-D067-4FC6-A049-462AFB532726">
      <semantic:text>if monthlyIncome != null and monthlyIncome &gt; 0 and monthlyDebt != null then monthlyDebt / monthlyIncome else null</semantic:text>
