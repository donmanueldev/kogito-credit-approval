    </semantic:informationRequirement>
    <semantic:literalExpression id="_31BF045F-9E06-4470-A2A3-48348C25D280">
      <semantic:text>customerId != null and customerId != &quot;&quot; and creditScore != null and creditScore &gt;= 0 and monthlyIncome != null and monthlyIncome &gt; 0 and monthlyDebt != null and monthlyDebt &gt;= 0 and requestedAmount != null and requestedAmount &gt; 0 and fraudConfirmed != null</semantic:text>
    </semantic:literalExpression>
