    </semantic:informationRequirement>
    <semantic:literalExpression id="_39CE6128-6CB7-4C4A-B72D-23835F31A096">
      <semantic:text>if fraudConfirmed = true then &quot;FRAUD_CONFIRMED&quot; else if inputValid = false then &quot;INVALID_INPUT&quot; else if approvalStatus = &quot;APPROVED&quot; then &quot;AUTOMATIC_APPROVAL&quot; else if approvalStatus = &quot;MANUAL_REVIEW&quot; then &quot;POLICY_REQUIRES_REVIEW&quot; else &quot;CREDIT_POLICY_NOT_MET&quot;</semantic:text>
    </semantic:literalExpression>
  </semantic:decision>
